<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_shareholders_tab" model="ir.ui.view">
        <field name="name">res.company.form.shareholders.tab</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <!-- Insert new tab after Other Information -->
            <xpath expr="//page[@name='other_information']" position="after">
                <page name="shareholder_information" string="Shareholder Information">

                    <group>
                        <!-- Shareholders Fields -->
                        <group string="Company Shareholders">
                            <field name="shareholder_ids" />
                            <field name="shareholder_1" nolabel="1"/>
                            <field name="shareholder_2" nolabel="1"/>
                            <field name="shareholder_3" nolabel="1"/>
                            <field name="shareholder_4" nolabel="1"/>
                            <field name="shareholder_5" nolabel="1"/>
                            <field name="shareholder_6" nolabel="1"/>
                            <field name="shareholder_7" nolabel="1"/>
                            <field name="shareholder_8" nolabel="1"/>
                            <field name="shareholder_9" nolabel="1"/>
                            <field name="shareholder_10" nolabel="1"/>
                        </group>

                        <!-- Nationalities Fields -->
                        <group string="Shareholder Nationality">
                            <field name="shareholders_nationalities" />
                            <field name="nationality_1" nolabel="1"/>
                            <field name="nationality_2" nolabel="1"/>
                            <field name="nationality_3" nolabel="1"/>
                            <field name="nationality_4" nolabel="1"/>
                            <field name="nationality_5" nolabel="1"/>
                            <field name="nationality_6" nolabel="1"/>
                            <field name="nationality_7" nolabel="1"/>
                            <field name="nationality_8" nolabel="1"/>
                            <field name="nationality_9" nolabel="1"/>
                            <field name="nationality_10" nolabel="1"/>
                        </group>
                    </group>

                </page>
            </xpath>

        </field>
    </record>
</odoo>