<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_hierarchy_audit_list" model="ir.ui.view">
        <field name="name">company.hierarchy.audit.list</field>
        <field name="model">company.hierarchy.audit</field>
        <field name="arch" type="xml">
            <list string="Hierarchy Audit Log" create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="scenario"/>
                <field name="source_company_id"/>
                <field name="old_parent_id"/>
                <field name="new_parent_id"/>
                <field name="affected_account_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_company_hierarchy_audit_form" model="ir.ui.view">
        <field name="name">company.hierarchy.audit.form</field>
        <field name="model">company.hierarchy.audit</field>
        <field name="arch" type="xml">
            <form string="Hierarchy Audit Log" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="scenario" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="source_company_id" readonly="1"/>
                            <field name="old_parent_id" readonly="1"/>
                            <field name="new_parent_id" readonly="1"/>
                            <field name="affected_account_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Snapshots">
                        <field name="old_parent_path" readonly="1"/>
                        <field name="new_parent_path" readonly="1"/>
                    </group>
                    <group string="Affected Users">
                        <field name="affected_user_ids" readonly="1" widget="many2many_tags"/>
                    </group>
                    <group string="Preflight JSON">
                        <field name="preflight_report_json" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_company_hierarchy_audit_search" model="ir.ui.view">
        <field name="name">company.hierarchy.audit.search</field>
        <field name="model">company.hierarchy.audit</field>
        <field name="arch" type="xml">
            <search string="Hierarchy Audit Log">
                <field name="name"/>
                <field name="source_company_id"/>
                <field name="user_id"/>
                <filter name="executed" string="Executed" domain="[('state', '=', 'executed')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="dry_run_pending" string="Pending Dry Runs" domain="[('state', '=', 'pending')]"/>
                <group>
                    <filter name="group_by_scenario" string="Scenario" context="{'group_by': 'scenario'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_company_hierarchy_audit" model="ir.actions.act_window">
        <field name="name">Hierarchy Audit Log</field>
        <field name="res_model">company.hierarchy.audit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_company_hierarchy_audit_search"/>
    </record>
</odoo>
