<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_bank_gl_label_sync" model="ir.ui.view">
        <field name="name">account.journal.form.bank.gl.label.sync</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='bank_account']/group/group[1]/field[@name='loss_account_id']" position="after">
                <separator string="GL Label Sync" invisible="type not in ('bank', 'cash')"/>
                <field name="use_bank_label_in_gl" invisible="type not in ('bank', 'cash')"/>
            </xpath>
        </field>
    </record>
</odoo>
