<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_knockoff_user" model="res.groups">
            <field name="name">AR/AP Knock-Off User</field>
            <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        </record>

        <record id="group_knockoff_manager" model="res.groups">
            <field name="name">AR/AP Knock-Off Manager</field>
            <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account_ar_ap_knockoff.group_knockoff_user'))]"/>
        </record>

        <record id="account.group_account_readonly" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('account_ar_ap_knockoff.group_knockoff_user'))]"/>
        </record>

        <record id="account.group_account_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('account_ar_ap_knockoff.group_knockoff_manager'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="account_knockoff_settlement_company_rule" model="ir.rule">
            <field name="name">AR/AP Knock-Off Settlement: company</field>
            <field name="model_id" ref="model_account_knockoff_settlement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account_ar_ap_knockoff.group_knockoff_user')), (4, ref('account_ar_ap_knockoff.group_knockoff_manager'))]"/>
        </record>

        <record id="account_knockoff_settlement_line_company_rule" model="ir.rule">
            <field name="name">AR/AP Knock-Off Settlement Line: company</field>
            <field name="model_id" ref="model_account_knockoff_settlement_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('account_ar_ap_knockoff.group_knockoff_user')), (4, ref('account_ar_ap_knockoff.group_knockoff_manager'))]"/>
        </record>
    </data>
</odoo>
