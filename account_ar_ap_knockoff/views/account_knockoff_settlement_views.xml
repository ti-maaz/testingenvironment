<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_knockoff_settlement_list" model="ir.ui.view">
        <field name="name">account.knockoff.settlement.list</field>
        <field name="model">account.knockoff.settlement</field>
        <field name="arch" type="xml">
            <list string="AR/AP Knock-Off Settlements"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'posted'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="settlement_date"/>
                <field name="settlement_type"/>
                <field name="partner_id" optional="hide"/>
                <field name="customer_partner_id" optional="show"/>
                <field name="vendor_partner_id" optional="show"/>
                <field name="journal_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" optional="hide"/>
                <field name="amount" sum="Total Amount"/>
                <field name="customer_residual_total" optional="hide"/>
                <field name="vendor_residual_total" optional="hide"/>
                <field name="move_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('submitted', 'approved')"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_account_knockoff_settlement_form" model="ir.ui.view">
        <field name="name">account.knockoff.settlement.form</field>
        <field name="model">account.knockoff.settlement</field>
        <field name="arch" type="xml">
            <form string="AR/AP Knock-Off Settlement">
                <header>
                    <button name="action_compute_allocation"
                            string="Compute Allocation"
                            type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            groups="account_ar_ap_knockoff.group_knockoff_user"
                            invisible="state != 'draft'"/>
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            groups="account_ar_ap_knockoff.group_knockoff_manager"
                            invisible="state != 'submitted'"/>
                    <button name="action_create_knockoff_entry"
                            string="Create Knock-Off Entry"
                            type="object"
                            class="btn-primary"
                            groups="account_ar_ap_knockoff.group_knockoff_manager"
                            invisible="state != 'approved'"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            groups="account_ar_ap_knockoff.group_knockoff_manager"
                            invisible="state in ('posted', 'cancelled')"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            groups="account_ar_ap_knockoff.group_knockoff_manager"
                            invisible="state not in ('submitted', 'cancelled') or move_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,posted"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move"
                                class="oe_stat_button"
                                icon="fa-book"
                                type="object"
                                invisible="not move_id">
                            <field name="journal_entry_count" string="Journal Entry" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="not warning_message">
                        <field name="warning_message" readonly="1" nolabel="1"/>
                    </div>

                    <group>
                        <group string="Settlement Info">
                            <field name="settlement_type" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                            <field name="journal_id"
                                   readonly="state != 'draft'"
                                   domain="[('type', '=', 'general'), ('company_id', '=', company_id)]"
                                   options="{'no_create': True}"/>
                            <field name="settlement_date" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="state" widget="badge" readonly="1"/>
                        </group>
                        <group string="Partner Info">
                            <field name="partner_id"
                                   invisible="settlement_type != 'same_partner'"
                                   readonly="1"/>
                            <field name="customer_partner_id"
                                   invisible="settlement_type != 'third_party'"
                                   readonly="1"/>
                            <field name="vendor_partner_id"
                                   invisible="settlement_type != 'third_party'"
                                   readonly="1"/>
                            <field name="reason"
                                   invisible="settlement_type != 'third_party'"
                                   required="settlement_type == 'third_party'"
                                   readonly="state != 'draft'"/>
                            <field name="attachment_ids"
                                   widget="many2many_binary"
                                   invisible="settlement_type != 'third_party'"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Documents" name="documents">
                            <group>
                                <group string="Customer-Side Documents">
                                    <field name="customer_invoice_ids"
                                           nolabel="1"
                                           widget="many2many_tags"
                                           readonly="state != 'draft'"
                                           domain="[('company_id', '=', company_id), ('state', '=', 'posted'), '|', '&amp;', ('move_type', '=', 'out_invoice'), ('payment_state', 'not in', ('paid', 'reversed')), ('move_type', '=', 'entry')]"
                                           options="{'no_create': True, 'no_open': False}"/>
                                </group>
                                <group string="Vendor-Side Documents">
                                    <field name="vendor_bill_ids"
                                           nolabel="1"
                                           widget="many2many_tags"
                                           readonly="state != 'draft'"
                                           domain="[('company_id', '=', company_id), ('state', '=', 'posted'), '|', '&amp;', ('move_type', '=', 'in_invoice'), ('payment_state', 'not in', ('paid', 'reversed')), ('move_type', '=', 'entry')]"
                                           options="{'no_create': True, 'no_open': False}"/>
                                </group>
                            </group>
                        </page>

                        <page string="Totals" name="totals">
                            <group>
                                <group>
                                    <field name="customer_residual_total" readonly="1"/>
                                    <field name="vendor_residual_total" readonly="1"/>
                                    <field name="max_settlement_amount" readonly="1"/>
                                </group>
                                <group>
                                    <field name="approval_user_id" readonly="1"/>
                                    <field name="approval_date" readonly="1"/>
                                    <field name="move_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Allocation Lines" name="allocation_lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="move_type"/>
                                    <field name="move_id" options="{'no_create': True}"/>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="residual_amount" readonly="1" sum="Residual"/>
                                    <field name="allocated_amount" sum="Allocated"/>
                                    <field name="currency_id" optional="hide"/>
                                    <field name="company_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes / Audit" name="audit">
                            <group>
                                <field name="reason" readonly="state != 'draft'" invisible="settlement_type != 'third_party'"/>
                                <field name="note" readonly="state == 'posted'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="view_account_knockoff_settlement_search" model="ir.ui.view">
        <field name="name">account.knockoff.settlement.search</field>
        <field name="model">account.knockoff.settlement</field>
        <field name="arch" type="xml">
            <search string="AR/AP Knock-Off Settlements">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="customer_partner_id"/>
                <field name="vendor_partner_id"/>
                <field name="move_id"/>
                <filter name="my_settlements" string="My Settlements" domain="[('create_uid', '=', uid)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <separator string="Group By"/>
                <filter name="same_partner" string="Same Partner" domain="[('settlement_type', '=', 'same_partner')]"/>
                <filter name="third_party" string="Third Party" domain="[('settlement_type', '=', 'third_party')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Settlement Type" context="{'group_by': 'settlement_type'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter name="group_date" string="Settlement Date" context="{'group_by': 'settlement_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="account_knockoff_settlement_action" model="ir.actions.act_window">
        <field name="name">AR/AP Knock-Off</field>
        <field name="res_model">account.knockoff.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_account_knockoff_settlement_search"/>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an AR/AP knock-off settlement
            </p>
            <p>
                Select open customer-side and vendor-side documents, including eligible journal entries, then compute allocation, approve, and create the audited reconciliation journal entry.
            </p>
        </field>
    </record>

    <menuitem id="menu_account_ar_ap_knockoff"
              name="AR/AP Knock-Off"
              parent="account.menu_finance_entries"
              action="account_knockoff_settlement_action"
              groups="account_ar_ap_knockoff.group_knockoff_user,account_ar_ap_knockoff.group_knockoff_manager"
              sequence="25"/>
</odoo>
