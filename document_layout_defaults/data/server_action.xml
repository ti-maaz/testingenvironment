<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Server action: "Apply Document Layout Defaults"
            Accessible from Settings > Technical > Companies list view (Action menu)
            or from any res.company list/form via the Actions button.
        -->
        <record id="action_apply_layout_defaults_all" model="ir.actions.server">
            <field name="name">Apply Document Layout Defaults</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="binding_model_id" ref="base.model_res_company"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
if records:
    records.action_apply_layout_defaults_all()
else:
    env['res.company'].action_apply_layout_defaults_all()
            </field>
        </record>

    </data>
</odoo>
