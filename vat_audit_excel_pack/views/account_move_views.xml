<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_vat_audit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.vat.audit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']/field[@name='invoice_date']" position="after">
                <field name="has_trn" invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')" readonly="state != 'draft'"/>
                <field name="has_company_name" invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
