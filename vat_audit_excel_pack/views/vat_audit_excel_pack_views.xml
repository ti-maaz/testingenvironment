<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_vat_audit_excel_pack_wizard_form" model="ir.ui.view">
            <field name="name">vat.audit.excel.pack.wizard.form</field>
            <field name="model">vat.audit.excel.pack.wizard</field>
            <field name="arch" type="xml">
                <form string="VAT Audit Excel Pack">
                    <sheet>
                        <group>
                            <group string="Filters">
                                <field name="company_id" options="{'no_create_edit': True}"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="target_move"/>
                            </group>
                            <group string="Core Sheets">
                                <field name="include_general_ledger"/>
                                <field name="include_trial_balance"/>
                                <field name="include_profit_loss"/>
                                <field name="include_balance_sheet"/>
                                <field name="include_aged_receivable"/>
                                <field name="include_aged_payable"/>
                            </group>
                        </group>
                        <group string="Included VAT Working Tabs">
                            <div class="o_form_label">
                                The workbook always includes Sale, Purchases, and Not Claimable tabs.
                            </div>
                        </group>
                        <group string="Last Generated File" invisible="not file_data">
                            <field name="file_name" readonly="1"/>
                            <field name="file_data" filename="file_name" readonly="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_generate_excel_pack" type="object" string="Generate Excel Pack" class="btn btn-primary"/>
                        <button string="Close" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_vat_audit_excel_pack_wizard" model="ir.actions.act_window">
            <field name="name">VAT Audit Excel Pack</field>
            <field name="res_model">vat.audit.excel.pack.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_vat_audit_excel_pack_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_vat_audit_excel_pack"
                  name="VAT Audit Excel Pack"
                  parent="account.menu_finance_reports"
                  action="action_vat_audit_excel_pack_wizard"
                  sequence="115"/>
    </data>
</odoo>
