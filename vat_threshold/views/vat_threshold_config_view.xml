<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings View for VAT Threshold -->
    <record id="vat_threshold_config_view_form" model="ir.ui.view">
        <field name="name">vat.threshold.config.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="VAT Threshold Settings" class="oe_form_configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>VAT Threshold Settings</h1>
                    </div>
                    <group string="Threshold Configuration">
                        <field name="cancellation_warning_threshold"/>
                        <field name="cancel_threshold"/>
                        <field name="voluntary_threshold"/>
                        <field name="mandatory_warning_threshold"/>
                        <field name="mandatory_threshold"/>
                        <p class="text-muted" colspan="2">
                            These values drive early warnings, VAT cancellation, voluntary registration,
                            mandatory registration, threshold breach dates, and all VAT threshold emails and reports.
                        </p>
                    </group>
                    <group string="Daily Report Configuration">
                        <field name="daily_report_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <p class="text-muted" colspan="2">
                            Select the internal users who should receive VAT threshold emails. Each user will only receive
                            companies that are assigned to them through their allowed companies.
                        </p>
                        <field name="daily_report_recipients" placeholder="admin@company.com, cfo@company.com"/>
                        <p class="text-muted" colspan="2">
                            Additional recipients who should always receive one consolidated report for all companies.
                        </p>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" type="object" name="action_save_settings" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to Open Settings -->
    <record id="action_vat_threshold_config" model="ir.actions.act_window">
        <field name="name">VAT Threshold Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="vat_threshold_config_view_form"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <!-- Settings Menu Item - under the standalone VAT Threshold root menu -->
    <menuitem id="menu_vat_threshold_config"
              name="VAT Threshold Settings"
              parent="vat_threshold.menu_vat_threshold_root"
              action="action_vat_threshold_config"
              sequence="20"
              groups="base.group_system"/>
</odoo>
